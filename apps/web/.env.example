# PostgreSQL Portal Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5544/postgres
PORTAL_SLUG=porciuncula_prefeitura

# Cloudflare R2 / MinIO S3 Parquet Endpoint (DuckDB Serverless)
# Local (MinIO): http://localhost:9000
# Produção (R2/CDN): https://pub-xxxxxx.r2.dev
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=transparencia-marts
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=transparencia-marts

# Assistente Fiscal AI (Vercel AI SDK + Google Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=sua_chave_gemini_aqui
GEMINI_API_KEY=sua_chave_gemini_aqui
