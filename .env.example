# Banco de Dados Principal (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5544/postgres
PORTAL_SLUG=porciuncula_prefeitura

# Assistente Fiscal AI (Vercel AI SDK + Google Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=sua_chave_gemini_aqui

# Rate Limiting do Assistente de IA (Cota diária anônima)
AI_ANONYMOUS_DAILY_LIMIT=5

# Redis (para rate limiting e cache de consultas)
REDIS_URL=redis://localhost:6379